# 心系 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 数据库连接地址（PostgreSQL）
DATABASE_URL=postgresql://username:password@localhost:5432/xinxi

# JWT 密钥（请使用随机字符串，越长越安全）
JWT_SECRET=please-change-this-to-a-long-random-secret-string

# AI 接口配置（可选，不配置则使用预设模板生成播报）
# 支持 OpenAI 兼容格式的 API（如豆包、通义千问、DeepSeek 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 后端服务端口（默认3001）
PORT=3001

# 前端构建相关
VITE_API_BASE_URL=
